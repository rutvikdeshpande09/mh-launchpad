# Copy this file to .env.local and fill in the values.  (.env.local is git-ignored.)

# ---------------------------------------------------------------- REQUIRED for AI
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model (default: gemini-3-flash-preview)
# GEMINI_MODEL=gemini-3-flash-preview

# ----------------------------------------------- OPTIONAL: Supabase (persistence)
# Without these the app still works: data is kept in memory and resets on restart.
# Create a free project at https://supabase.com, run supabase/schema.sql, then copy
# the values from Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never expose this key in client code or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------ OPTIONAL
# Secret used to sign Tech Ambassador session tokens. Set any long random string in
# production:  openssl rand -base64 32
APP_SECRET=
